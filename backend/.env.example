# Copy this file to `.env` in the same directory (backend/.env) and fill in your keys.
# Never commit the real .env file.

# Required: powers the AI assistant (chat explainer). Get a key at
# https://platform.kimi.ai
MOONSHOT_API_KEY=
# Optional: the Moonshot (Kimi) model used for the chat assistant.
MOONSHOT_MODEL=kimi-k2.6

# Optional: only needed if you swap the AI backend to DeepSeek or Claude (see
# backend/app/services/deepseek_service.py / claude_service.py). Not used by
# default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Tapetide is bring-your-own-key -- each user enters their own key through
# the website's sign-in gate, not a server-side .env secret. Nothing to set
# here for it.

# Optional: only needed if you swap the data provider to one of these instead
# (see backend/app/services/data_provider.py). Not used by default.
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Optional, DEV-ONLY: caches both Tapetide's and Bharat-SM-Data's API
# responses to this directory so repeated local testing doesn't burn
# Tapetide's free tier (50 calls/day) or wait on Bharat's slower per-call
# fetches. Never set this in a real deployment -- see tapetide_provider.py's
# and bharat_sm_provider.py's docstrings.
DEV_CACHE_DIR=

# Origin(s) the frontend dev server runs on, comma-separated. Adjust if you
# change the Vite dev server port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
