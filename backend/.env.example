# Copy this file to `.env` in the same directory (backend/.env) and fill in your keys.
# Never commit the real .env file.

# Required: Postgres connection string -- use the Neon `dev` branch's pooled
# string here, never production's (production's lives only in Vercel). See
# CLAUDE.md's Testing section for the dev/test branch setup.
DATABASE_URL=

# Tests only: the Neon `test` branch's pooled string. The test suite wipes
# tables and refuses to run unless this database is labelled 'test'.
TEST_DATABASE_URL=

# Required: powers the AI assistant (chat explainer). Get a key at
# https://platform.kimi.ai
MOONSHOT_API_KEY=
# Optional: the Moonshot (Kimi) model used for the chat assistant.
MOONSHOT_MODEL=kimi-k2.6

# Optional: only needed if you swap the AI backend to DeepSeek or Claude (see
# backend/app/services/deepseek_service.py / claude_service.py). Not used by
# default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Optional: powers "forgot password" reset emails via Gmail's own SMTP
# (see backend/app/services/gmail_service.py) -- no new third-party email
# provider, just an existing Gmail account. GMAIL_APP_PASSWORD must be an
# App Password (https://myaccount.google.com/apppasswords), NOT the
# account's real password -- Google blocks plain-password SMTP auth by
# default, and generating an App Password requires 2-Step Verification to
# already be turned on for that account. Without both set, forgot-password
# requests still return success (never leaks whether an email has an
# account), but no email actually goes out -- logged server-side instead.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: only needed if you swap the data provider to one of these instead
# (see backend/app/services/data_provider.py). Not used by default.
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Optional, DEV-ONLY: caches the dormant Bharat-SM-Data provider's responses
# to this directory. Never set this in a real deployment.
DEV_CACHE_DIR=

# Origin(s) the frontend dev server runs on, comma-separated. Adjust if you
# change the Vite dev server port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
